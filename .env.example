# Docker Compose / Spring Boot
MYSQL_USERNAME=njupt
MYSQL_PASSWORD=njupt_dev_password
MYSQL_ROOT_PASSWORD=njupt_root_password
MYSQL_PORT=3307
DATABASE_URL=jdbc:mysql://localhost:3307/njupt_ai_assistant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Chat answer provider: deepseek for RAG answers, mock for offline demos
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# DeepSeek Chat API environment fallback (never commit a real key)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONNECT_TIMEOUT=3s
DEEPSEEK_READ_TIMEOUT=45s
DEEPSEEK_MAX_TOKENS=1200
# Base64-encoded 32-byte key used only to encrypt admin-saved credentials.
# Example generation: openssl rand -base64 32
AI_CONFIG_MASTER_KEY=
CHAT_MAX_HISTORY_MESSAGES=12
CHAT_MAX_HISTORY_CHARACTERS=6000

# CORS must be an explicit comma-separated allow-list in production
CORS_ALLOWED_ORIGINS=http://localhost:4174

# Admin-only JWT. Generate a random 32+ byte secret and a bcrypt password hash.
ADMIN_ID=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL=2h

# Anonymous conversation retention and distributed rate limiting
ANONYMOUS_SESSION_RETENTION=90d
ANONYMOUS_SESSION_CLEANUP_CRON=0 30 3 * * *
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=REDIS
RATE_LIMIT_REDIS_URI=redis://localhost:6380
CHAT_IP_RATE_LIMIT=60
CHAT_SESSION_RATE_LIMIT=30
ADMIN_IP_RATE_LIMIT=20
ADMIN_LOGIN_IP_RATE_LIMIT=5

# Knowledge service / RAG retrieval
RAG_SERVICE_BASE_URL=http://localhost:8090
RAG_CONNECT_TIMEOUT=2s
RAG_READ_TIMEOUT=10s
RAG_INDEX_READ_TIMEOUT=60s
RAG_INDEXING_ENABLED=true
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_MIN_RELEVANCE_SCORE=0.35
KNOWLEDGE_SERVICE_PORT=8090

# Official website crawler
CRAWLER_SERVICE_PORT=8091
CRAWLER_SERVICE_BASE_URL=http://localhost:8091
CRAWLER_BACKEND_BASE_URL=http://host.docker.internal:8080
CRAWLER_SHARED_TOKEN=njupt-crawler-local-token
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=2
CRAWLER_REQUEST_DELAY_SECONDS=1.5
CRAWLER_REQUEST_TIMEOUT_SECONDS=15
CRAWLER_MAX_RETRIES=2
CRAWLER_SCHEDULE_ENABLED=true
CRAWLER_SCHEDULE_INTERVAL_HOURS=24
CRAWLER_ALLOWED_DOMAINS=www.njupt.edu.cn,jwc.njupt.edu.cn,cs.njupt.edu.cn
CRAWLER_SEED_URLS=https://www.njupt.edu.cn/,https://jwc.njupt.edu.cn/,https://cs.njupt.edu.cn/

# Use "hash" for local smoke tests, "openai-compatible" for real embeddings
EMBEDDING_PROVIDER=hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_COLLECTION_NAME=njupt_knowledge
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
