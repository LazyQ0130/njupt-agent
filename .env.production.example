# Copy this file to .env.production on the server and replace every REPLACE_* value.
# Keep passwords hexadecimal so they remain safe in JDBC URLs, Redis URLs, and Compose.

PUBLIC_ORIGIN=https://njupt-ai.top
CORS_ALLOWED_ORIGINS=https://njupt-ai.top

MYSQL_USERNAME=njupt
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX

REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX

ADMIN_ID=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
ADMIN_JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
ADMIN_JWT_TTL=2h

AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONNECT_TIMEOUT=3s
DEEPSEEK_READ_TIMEOUT=45s
DEEPSEEK_MAX_TOKENS=1200
AI_CONFIG_MASTER_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

RAG_READ_TIMEOUT=10s
RAG_INDEX_READ_TIMEOUT=60s

RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=REDIS
CHAT_IP_RATE_LIMIT=60
CHAT_SESSION_RATE_LIMIT=30
ADMIN_IP_RATE_LIMIT=20
ADMIN_LOGIN_IP_RATE_LIMIT=5

ANONYMOUS_SESSION_RETENTION=90d
ANONYMOUS_SESSION_CLEANUP_CRON=0 30 3 * * *
CHAT_MAX_HISTORY_MESSAGES=12
CHAT_MAX_HISTORY_CHARACTERS=6000

RAG_INDEXING_ENABLED=true
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_MIN_RELEVANCE_SCORE=0.35

# Production retrieval requires a Chinese-capable real embedding service.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_KEY
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_COLLECTION_NAME=njupt_knowledge_v2
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

CRAWLER_SHARED_TOKEN=REPLACE_WITH_RANDOM_HEX
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=2
CRAWLER_REQUEST_DELAY_SECONDS=1.5
CRAWLER_REQUEST_TIMEOUT_SECONDS=15
CRAWLER_MAX_RETRIES=2
CRAWLER_SCHEDULE_ENABLED=false
CRAWLER_SCHEDULE_INTERVAL_HOURS=24
CRAWLER_ALLOWED_DOMAINS=www.njupt.edu.cn,jwc.njupt.edu.cn,cs.njupt.edu.cn
CRAWLER_SEED_URLS=https://www.njupt.edu.cn/,https://jwc.njupt.edu.cn/,https://cs.njupt.edu.cn/
